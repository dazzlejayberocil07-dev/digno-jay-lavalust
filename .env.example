# Copy this file to .env and update the values below
# Environment variables for LavaLust API & Aiven MySQL Database

# Application Settings
APP_NAME="Lavalust Product API"
APP_ENV=production
ENVIRONMENT=production

# Database Configuration (Aiven MySQL / Local MariaDB)
DB_DRIVER=pdo
DB_HOST=your-aiven-db-host.aivencloud.com
DB_PORT=26252
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password
DB_NAME=defaultdb

# JWT & API Security Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_123456
REFRESH_TOKEN_KEY=super_secret_refresh_token_key_at_least_32_chars
ALLOW_ORIGIN=*
